# ============================================================
#  IRMS - Internal Recruitment Management System
#  Backend Environment Configuration (Example Template)
# ============================================================

NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ttcs_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT & Session Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_chars_here
JWT_ACCESS_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_DAYS=7
SESSION_SECRET=your_session_secret_key_min_32_chars_here
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SESSION_RENEW_THRESHOLD_SECONDS=600

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# CORS - Frontend origin
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# Mail Service (MailHog / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="IRMS Recruitment System" <noreply@company.local>
APP_URL=http://localhost:5173
