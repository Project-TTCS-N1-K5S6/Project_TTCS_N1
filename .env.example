# ============================================================
#  IRMS - Internal Recruitment Management System
#  Cấu hình kết nối vào Database chung của nhóm (Máy chủ: 192.168.1.12)
# ============================================================

PORT=8080

# MySQL Database Configuration
DB_HOST=192.168.1.12
DB_PORT=3306
DB_NAME=test
DB_USER=team_dev
DB_PASSWORD=123456
DB_POOL_MIN=5
DB_POOL_MAX=20

# Security & Session Settings
JWT_ACCESS_SECRET=irms_super_secure_jwt_secret_key_minimum_32_characters_long_2026
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
SESSION_TIMEOUT_MINUTES=60

# Mail Service
# - MAIL_PROVIDER: 'auto' (khuyến nghị dev), 'mailhog' (Mailpit/MailHog cổng 1025), hoặc 'gmail'
# - Nếu dùng Gmail: Cần bật 2FA trên tài khoản Google và tạo Mật khẩu ứng dụng (App Password 16 ký tự)
# - Nếu dùng Mailpit/MailHog: Chạy sẵn tại localhost:1025 (Web UI: http://localhost:8025)
MAIL_PROVIDER=auto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM=IRMS Recruitment Platform <your_email@gmail.com>
APP_URL=http://localhost:8088 