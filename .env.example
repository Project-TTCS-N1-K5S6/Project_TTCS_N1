# ============================================================
#  IRMS - Internal Recruitment Management System
#  Backend Environment Configuration (MySQL & Java Servlet)
# ============================================================

# Server Port
PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ttcs_db
DB_USER=root
DB_PASSWORD=root
DB_POOL_MIN=5
DB_POOL_MAX=20

# Security & Session Settings
JWT_ACCESS_SECRET=irms_super_secure_jwt_secret_key_minimum_32_characters_long_2026
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
SESSION_TIMEOUT_MINUTES=60

# Mail Service (Hỗ trợ song song cả MailHog & Gmail SMTP)
# MAIL_PROVIDER=auto | mailhog | gmail
# - Nếu để trống SMTP_USER/PASSWORD: tự động dùng MailHog (localhost:1025, Web UI http://localhost:8025)
# - Nếu điền Gmail & App Password (16 ký tự): tự động dùng Gmail SMTP (smtp.gmail.com:587)
MAIL_PROVIDER=auto
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=IRMS Recruitment Platform <noreply@company.local>
APP_URL=http://localhost:8080
