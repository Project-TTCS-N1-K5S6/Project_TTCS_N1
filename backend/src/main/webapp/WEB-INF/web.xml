<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>IRMS Internal Recruitment Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Company Profile & Public Portals enabled -->

    <!-- Cấu hình thời gian hết hạn phiên làm việc (Session Timeout: 30 phút) [US 2] -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!--
        [BUG FIX]: Khai báo UserServlet trong web.xml với <multipart-config>
        để Tomcat 7 Maven Plugin nhận diện và kích hoạt xử lý multipart form-data.
        @MultipartConfig annotation đôi khi không được tomcat7-maven-plugin:2.2 xử lý
        đúng cách, gây ra lỗi HTTP 500 khi gọi request.getPart() trong validate-excel.
    -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.irms.controller.UserServlet</servlet-class>
        <multipart-config>
            <!-- 2MB file size threshold trước khi ghi ra disk -->
            <file-size-threshold>2097152</file-size-threshold>
            <!-- Max 5MB mỗi file -->
            <max-file-size>5242880</max-file-size>
            <!-- Max 10MB toàn bộ request -->
            <max-request-size>10485760</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/create</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/edit</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/lock</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/unlock</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/reset-password</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/excel-template</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/validate-excel</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/admin/users/import-excel</url-pattern>
    </servlet-mapping>

    <!-- Định nghĩa các trang thông báo lỗi tùy biến -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/errors/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/errors/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/errors/500.jsp</location>
    </error-page>

</web-app>
