{
  "name": "irms-root",
  "version": "1.0.0",
  "private": true,
  "description": "Internal Recruitment Management System (IRMS) - Java Servlet & JSP, MySQL, Bootstrap 5 & SASS",
  "scripts": {
    "start": "node server.js",
    "sass:build": "sass src/main/webapp/assets/scss/main.scss src/main/webapp/assets/css/main.css --no-source-map",
    "sass:watch": "sass --watch src/main/webapp/assets/scss/main.scss:src/main/webapp/assets/css/main.css",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mysql"
  },
  "devDependencies": {
    "sass": "^1.85.0"
  }
}
